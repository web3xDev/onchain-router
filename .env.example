# Copy to .env.local (Next.js) — scripts/pay.ts also reads .env.local via dotenv.
# NEVER commit real keys. .env* is gitignored.

# ── Hedera testnet wallets ───────────────────────────────────────────────────
# Create two ECDSA accounts at https://portal.hedera.com and fund both with testnet HBAR.

# Agent wallet — pays for tool calls
HEDERA_AGENT_ACCOUNT_ID=0.0.XXXXX
HEDERA_AGENT_PRIVATE_KEY=0x...

# Service wallet — receives payments
HEDERA_SERVICE_ACCOUNT_ID=0.0.YYYYY

# ── x402 ─────────────────────────────────────────────────────────────────────
# Blocky402 testnet facilitator. Required by the Hedera bounty.
# Verified: https://api.testnet.blocky402.com/supported advertises hedera:testnet.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Payment asset: "hbar" (default) or "usdc".
#   hbar — native HBAR, needs no HTS token association. Use this first.
#   usdc — testnet USDC 0.0.429274 (6 decimals). The SERVICE wallet must be
#          associated with that token first or settlement fails with
#          TOKEN_NOT_ASSOCIATED_TO_ACCOUNT.
X402_ASSET=hbar

# Price when X402_ASSET=hbar. Tinybar, 8 decimals. 10000000 = 0.1 HBAR.
X402_HBAR_TINYBAR=10000000

# Price when X402_ASSET=usdc.
X402_PRICE=$0.01

# ── Arc (second rail, optional) ──────────────────────────────────────────────
# Arc settles through Circle Gateway. Leave these unset and the router simply does
# not advertise Arc; the Hedera rail keeps working on its own.
#
# Setup, in order:
#   1. Fund an EVM address with Arc testnet USDC (https://faucet.circle.com)
#   2. Deposit that USDC into the Gateway Wallet once, on-chain. Payments are
#      gasless afterwards but they draw on the Gateway balance, not the wallet
#      balance, so skipping this step makes every payment fail.
#
# Arc testnet: chain 5042002 · USDC 0x3600...0000 (6 decimals)
# Gateway Wallet: 0x0077777d7EBA4688BDeF3E311b846F25870A19B9

# Receiving address. Arc is only offered as a payment option once this is set.
# ARC_SERVICE_ADDRESS=0x...

# Paying agent's EVM key
# ARC_AGENT_PRIVATE_KEY=0x...

# Price in atomic USDC (6 decimals). 10000 = $0.01
# X402_ARC_AMOUNT=10000

# ── The Graph ────────────────────────────────────────────────────────────────
# Tools read live data through The Graph. Create a key at thegraph.com/studio.
GRAPH_API_KEY=

# ── Test client ──────────────────────────────────────────────────────────────
TOOL_URL=http://localhost:3000/api/tools/test

# Force a rail: "hedera:testnet" or "eip155:5042002". Unset = first offered.
# PAY_NETWORK=hedera:testnet

# ── Circle agent wallet (Arc) ────────────────────────────────────────────────
# When these are set the Arc rail signs through a Circle-held agent wallet instead
# of a local key. Unset, it falls back to ARC_AGENT_PRIVATE_KEY.
#
# console.circle.com -> API key, then register an entity secret, then create a
# developer-controlled wallet on ARC-TESTNET. Choose account type EOA, not SCA:
# Gateway verifies an ECDSA signature.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=
